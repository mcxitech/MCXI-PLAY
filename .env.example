# MCXI Play — Environment Variables
# Copy to .env and fill in real values. Never commit .env itself.

# Admin password hash (generate with: npx wrangler secret put ADMIN_PASSWORD_HASH)
# ADMIN_PASSWORD_HASH=

# D1 database name (set in wrangler.toml)
# D1_DATABASE_NAME=mcxi-play-db

# HMAC secret used to sign admin session cookies (min. 32 chars, random).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Production: npx wrangler secret put SESSION_SECRET
# SESSION_SECRET=
